{
  "name": "aprovaai",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "pnpm --filter @aprovaai/web test:e2e",
    "db:generate": "pnpm --filter @aprovaai/db db:generate",
    "db:migrate": "pnpm --filter @aprovaai/db db:migrate",
    "db:seed": "pnpm --filter @aprovaai/db db:seed",
    "user:set-role": "pnpm --filter @aprovaai/api user:set-role",
    "feature:set": "pnpm --filter @aprovaai/api feature:set",
    "radar:collect": "pnpm --filter @aprovaai/api radar:collect",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:sample": "pnpm --filter @aprovaai/db db:sample",
    "db:sample:remove": "pnpm --filter @aprovaai/db db:sample:remove"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "eslint": "^10.13.0",
    "globals": "^16.0.0",
    "prettier": "^3.9.10",
    "turbo": "^2.11.10",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.72.1"
  }
}

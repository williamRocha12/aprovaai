# Copie para .env:  Copy-Item .env.example .env
# Valores abaixo são de desenvolvimento local (Docker Compose). Nunca commite o .env.
# Em produção (Vercel), configure as variáveis no painel do projeto: ver docs/deploy.md.

NODE_ENV=development
LOG_LEVEL=info

# --- Banco (docker compose up -d) ---
# Na Vercel, DATABASE_URL (pooled) e DATABASE_URL_UNPOOLED vêm da integração Neon do Marketplace.
DATABASE_URL=postgres://aprovaai:aprovaai@localhost:5432/aprovaai
# Banco separado usado pelos testes de integração (criado pelo docker/postgres-init.sql)
DATABASE_URL_TEST=postgres://aprovaai:aprovaai@localhost:5432/aprovaai_test

# --- App (web + API embutida em /api) ---
# URL pública. Na Vercel pode ficar vazia: produção usa o domínio do projeto e preview usa a URL do deploy.
APP_URL=http://localhost:3000
# Origens extras confiáveis (separadas por vírgula), ex.: domínio próprio além do .vercel.app
TRUSTED_ORIGINS=
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=troque-por-um-segredo-aleatorio-de-32+-caracteres
RATE_LIMIT_ENABLED=true
# Header com o IP real do cliente, definido pela borda confiável. Na Vercel o padrão já é x-real-ip.
# Vazio em dev: o rate limit agrupa todos num balde só. Obrigatório em produção fora da Vercel.
CLIENT_IP_HEADER=
# Swagger UI em /api/docs (padrão: ligado fora de produção)
API_DOCS_ENABLED=

# --- Login Google (opcional; também precisa da feature flag google_login ligada) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- E-mail ---
# smtp (Mailpit em dev: http://localhost:8025) | resend (produção) | memory (testes)
EMAIL_PROVIDER=smtp
EMAIL_FROM=AprovaAI <nao-responda@aprovaai.local>
SMTP_HOST=localhost
SMTP_PORT=1025
RESEND_API_KEY=

# --- IA (opcional; também precisa da feature flag ai ligada) ---
# Sem chave, os recursos de IA ficam desligados (nunca simulados).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# Usos de IA por usuário a cada 24 horas
AI_DAILY_QUOTA=30

# --- Fila de tarefas (cron) ---
# A Vercel Cron envia "Authorization: Bearer $CRON_SECRET" (mín. 16 caracteres). Sem valor, /api/cron/jobs responde 404.
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=

# --- Deploy na Vercel (só no painel) ---
# MIGRATE_ON_PREVIEW=true  → apenas se a integração Neon criar um branch de banco por preview

# --- Testes E2E ---
# API do Mailpit, usada pelo Playwright para ler o e-mail de verificação
MAILPIT_URL=http://localhost:8025
